       E000-Control-Base-Ex.                                            09860068
           Exit.                                                        09870068
      *</META>                                                          09880068
                                                                        09890068
      *################################################################*09900068
       E100-Check-Status                 Section.                       09910068
      *                                                                 09920068
           Initialize                          R115L050-Initial-Check   09930068
           Set   R115L050-Version        To    True                     09940068
      *                                                                 09950068
           Move  R400CH01-Function       To    R115L050-Function        09960068
           Move  R400CH01-Medium         To    R115L050-Medium          09970068
           Move  RTFCE110-I-Fin-Inst-No-D                               09980068
                                         To    R115L050-Fin-Inst-No     09990068
           Move  RTFCE110-I-Contract-Type-D                             10000068
                                         To    R115L050-Contr-Type      10010068
           Move  RTFCE110-I-Contract-No-D                               10020068
                                         To    R115L050-Contr-No        10030068
      *                                                                 10040068
           If  RTFCE110-I-Part-Amount-No-I = 'U'                        10050068
               Move  RTFCE110-I-Part-Amount-No-D                        10060068
                                         To    R115L050-PA-Seq-No       10070068
           End-If                                                       10080068
      *                                                                 10090068
           Move  RTFCE110-I-Operation-Type-D                            10100068
                                         To    R115L050-Operation-Type  10110068
           Move  RTFCE110-B-Last-Saved-Date-D                           10120068
                                         To    R115L050-Last-Update-TX  10130068
           Set   R115L050-Check-For-Upd-Yes                             10140068
                                         To    True                     10150068
      *                                                                 10160068
           Call  'F115L050'              Using R115L050-Initial-Check   10170068
                                               R7919999-Error           10180068
           End-Call                                                     10190068
      *                                                                 10200068
           Evaluate True                                                10210068
             When R7919999-Return-Abend                                 10220068
                                                                        10230068
               Move  'E101'              To    R7919999-Paragraph       10240068
               Move  'FM'                To    R400CH01-Message-Code    10250068
               Perform Z900-Abend                                       10260068
                                                                        10270068
             When R7919999-Return-Error                                 10280068
               Move  'E102'              To    R7919999-Paragraph       10290068
               Move  'FM'                To    R400CH01-Message-Code    10300068
               Perform Z700-Error-AE                                    10310068
                                                                        10320068
             When R7919999-Return-OK                                    10330068
               Continue                                                 10340068
           End-Evaluate                                                 10350068
      *                                                                 10360068
           .                                                            10370068
      *                                                                 10380068
       E100-Check-Status-Ex.                                            10390068
           Exit.                                                        10400068
      *################################################################*10410068
       E200-Check-Part-Amount            Section.                       10420068
      *                                                                 10430068
           Perform E210-Read-Part-Amount                                10440068
      *                                                                 10450068
           Move  1                       To    Ws-Idx                   10460068
           Perform Until Ws-Idx > Ws-Max-Occ-Item-Tab                   10470068
                                                                        10480068
               If  RTFCE110-I-Type-I (Ws-Idx) = 'U'                     10490068
               And RTFCE110-I-Type-D (Ws-Idx) = 'AGENT'                 10500068
               And Wb-PA-Settled                                        10510068
                                                                        10520068
                   Move  'F'             To    RTFCE110-I-Type-O        10530068
                                               (Ws-Idx)                 10540068
                   Move  'TF-SY-STATUS-SETTLED'                         10550068
                                         To    R400CH01-Message-Code    10560068
                   Perform  Z700-Error-AE                               10570068
               End-If                                                   10580068
                                                                        10590068
               Add  1                    To    Ws-Idx                   10600068
           End-Perform                                                  10610068
      *                                                                 10620068
           .                                                            10630068
      *                                                                 10640068
       E200-Check-Part-Amount-Ex.                                       10650068
           Exit.                                                        10660068
      *################################################################*10670068
       E210-Read-Part-Amount             Section.                       10680068
      *                                                                 10690068
           Initialize                          R115IPA0-Part-Amount     10700068
           Set   R115IPA0-Version        To    True                     10710068
           Set   R115IPA0-In-Get-1st     To    True                     10720068
           Set   R115IPA0-In-Actual      To    True                     10730068
      *                                                                 10740068
           Move  RTFCE110-I-Fin-Inst-No-D                               10750068
                                         To    R115IPA0-In-Fin-Inst-No  10760068
           Move  RTFCE110-I-Contract-Type-D                             10770068
                                         To    R115IPA0-In-Contract-Type10780068
           Move  RTFCE110-I-Contract-No-D                               10790068
                                         To    R115IPA0-In-Contract-No  10800068
      *                                                                 10810068
           Call  'F115IPA0'              Using R115IPA0-Part-Amount     10820068
                                               R7919999-Error-Area      10830068
           End-Call                                                     10840068
      *                                                                 10850068
           Set   Wb-PA-Not-Settled       To    True                     10860068
      *                                                                 10870068
           Perform Until R7919999-Return-Error                          10880068
                      Or Wb-PA-Settled                                  10890068
                                                                        10900068
                If  R7919999-Return-Abend                               10910068
                    Move  'E211'         To    R7919999-Paragraph       10920068
                    Move  'FM'           To    R400CH01-Message-Code    10930068
                    Perform Z900-Abend                                  10940068
                End-If                                                  10950068
                                                                        10960068
                If  R115IPA0-Status = 'SETTLED'                         10970068
                    Set Wb-PA-Settled    To    True                     10980068
                End-If                                                  10990068
                                                                        11000068
                Set  R115IPA0-In-Get-Next                               11010068
                                         To    True                     11020068
                Call  'F115IPA0'         Using R115IPA0-Part-Amount     11030068
                                               R7919999-Error-Area      11040068
                End-Call                                                11050068
                                                                        11060068
           End-Perform                                                  11070068
           Set R7919999-Return-OK        To    True                     11080068
      *                                                                 11090068
           .                                                            11100068
      *                                                                 11110068
       E210-Read-Part-Amount-Ex.                                        11120068
           Exit.                                                        11130068
      *################################################################*11140068
       E300-Check-Related-Party          Section.                       11150068
      *                                                                 11160068
           Move  1                       To    Ws-Idx                   11170068
      *                                                                 11180068
           Perform Until Ws-Idx > Ws-Max-Occ-Item-Tab                   11190068
                                                                        11200068
               Evaluate True                                            11210068
                                                                        11220068
      *                                                                 11230068
      *           O-Bank's reference must be unique.                    11240068
      *                                                                 11250068
      *          When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            11260068
      *           And RTFCE110-I-Type-D (Ws-Idx)       = 'REMIT'        11270068
      *           And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            11280068
      *           And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            11290068
      *           And RTFCE110-I-Operation-Type-D      = 'REGISTER'     11300068
      *           And RTFCE110-I-Reference-I (Ws-Idx)  = 'U'            11310068
      *            Set  Wb-Remit         To    True                     11320068
      *            Perform E320-Read-All-Related-Party                  11330068
      *                                                                 11340068
      *                                                                 11350068
      *           Issuing bank's reference must be unique.              11360068
      *                                                                 11370068
      *          When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            11380068
      *           And RTFCE110-I-Type-D (Ws-Idx)       = 'ISSUI'        11390068
      *           And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            11400068
      *           And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            11410068
      *           And RTFCE110-I-Operation-Type-D      = 'ADVICE'       11420068
      *           And RTFCE110-I-Reference-I (Ws-Idx)  = 'U'            11430068
      *            Set  Wb-Issui         To    True                     11440068
      *            Perform E320-Read-All-Related-Party                  11450068
      *                                                                 11460068
      *                                                                 11470068
      *           We can change the reference of the collecting bank    11480068
      *                                                                 11490068
                 When RTFCE110-I-Type-I     (Ws-Idx)   = 'U'            11500068
                  And RTFCE110-I-Type-D     (Ws-Idx)   = 'ISSUI'        11510068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            11520068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            11530068
                  And   RTFCE110-I-Operation-Type-D  = 'AMEND-ELC-MAIN' 11540068
                   If (   RTFCE110-I-Customer-Id-I   (Ws-Idx) = 'U'     11550068
                        Or RTFCE110-I-Account-No-1-I (Ws-Idx) = 'U'     11560068
                        Or RTFCE110-I-Account-No-2-I (Ws-Idx) = 'U' )   11570068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  11580068
                       Move  'Utstedende banks'                         11590068
                                         To    R400CH01-Message-Data(1) 11600068
                       Move  'TF-SY-CHANGE-REF-ALLOWED'                 11610068
                                         To   R400CH01-Message-Code     11620068
                       Perform  Z700-Error-AE                           11630068
                   End-If                                               11640068
      *                                                                 11650068
      *           We can change the reference of the collecting bank    11660068
      *                                                                 11670068
                 When RTFCE110-I-Type-I     (Ws-Idx)   = 'U'            11680068
                  And RTFCE110-I-Type-D     (Ws-Idx)   = 'COLL'         11690068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            11700068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            11710068
                  And (   RTFCE110-I-Operation-Type-D  = 'ACCEPT-COLL'  11720068
                       Or RTFCE110-I-Operation-Type-D  = 'SETTLE-COLL') 11730068
      *                Or RTFCE110-I-Operation-Type-D                   11740068
      *                                            = 'AMEND-COLL-MAIN') 11750068
                   If (   RTFCE110-I-Customer-Id-I   (Ws-Idx) = 'U'     11760068
                        Or RTFCE110-I-Account-No-1-I (Ws-Idx) = 'U'     11770068
                        Or RTFCE110-I-Account-No-2-I (Ws-Idx) = 'U' )   11780068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  11790068
                       Move  'I-Banks'   To    R400CH01-Message-Data(1) 11800068
                       Move  'TF-SY-CHANGE-REF-ALLOWED'                 11810068
                                         To    R400CH01-Message-Code    11820068
                       Perform  Z700-Error-AE                           11830068
                   End-If                                               11840068
                                                                        11850068
      *                                                                 11860068
      *           We can only register a new party if it does not       11870068
      *           allready exist.                                       11880068
      *                                                                 11890068
      *          When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            11900068
      *           And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            11910068
      *           And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            11920068
      *           And RTFCE110-I-Operation-Type-D  = 'SETTLE-COLL'      11930068
      *            Move RTFCE110-I-Type-D (Ws-Idx)                      11940068
      *                                  To    Wb-Role-Type             11950068
      *            Perform E310-Read-Related-Party                      11960068
      *                                                                 11970068
      *            If  R7919999-Return-OK                               11980068
      *            And (   Wb-Role-Type = 'AGENB'                       11990068
      *                 Or Wb-Role-Type = 'OCCLA'                       12000068
      *                 Or Wb-Role-Type = 'ACRCL'                       12010068
      *                 Or Wb-Role-Type = 'INTEA'                       12020068
      *                 Or Wb-Role-Type = 'OCRCL'                       12030068
      *                 Or Wb-Role-Type = 'TCRCL'                       12040068
      *                 Or Wb-Role-Type = 'INTER'                       12050068
      *                 Or Wb-Role-Type = 'BENEB' )                     12060068
      *                Perform E330-Read-SYS-Code                       12070068
      *                Move  'F'         To    RTFCE110-I-Type-O        12080068
      *                                        (Ws-Idx)                 12090068
      *                Move  'VAR1'      To    R400CH01-Message-Key(1)  12100068
      *                Move  R115ISC0-Description                       12110068
      *                                  To    R400CH01-Message-Data(1) 12120068
      *                Move  'TF-SY-VAR-EXISTS'                         12130068
      *                                  To    R400CH01-Message-Code    12140068
      *                Perform  Z700-Error-AE                           12150068
      *            Else                                                 12160068
      *                Set R7919999-Return-OK  To True                  12170068
      *            End-If                                               12180068
      *                                                                 12190068
      *                                                                 12200068
      *           We can change the account no of the drawer and drwee. 12210068
      *                                                                 12220068
                 When RTFCE110-I-Type-I     (Ws-Idx)   = 'U'            12230068
                  And (  RTFCE110-I-Type-D     (Ws-Idx)   = 'DRWEE'     12240068
                      Or RTFCE110-I-Type-D     (Ws-Idx)   = 'DRWER' )   12250068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            12260068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            12270068
                  And RTFCE110-I-Operation-Type-D  = 'RETURN-COLL'      12280068
                  And RTFCE110-I-Part-Amount-No-I  Not = 'U'            12290068
                                                                        12300068
                   If (   RTFCE110-I-Customer-Id-I   (Ws-Idx) = 'U'     12310068
                        Or RTFCE110-I-Reference-I    (Ws-Idx) = 'U' )   12320068
                       Move RTFCE110-I-Type-D     (Ws-Idx)              12330068
                                         To    Wb-Role-Type             12340068
                       Perform E330-Read-SYS-Code                       12350068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  12360068
                       Move  R115ISC0-Description                       12370068
                                         To    R400CH01-Message-Data(1) 12380068
                       Move  'TF-SY-CHANGE-ACC-ALLOWED'                 12390068
                                         To    R400CH01-Message-Code    12400068
                       Perform  Z700-Error-AE                           12410068
                   End-If                                               12420068
                                                                        12430068
      *                                                                 12440068
      *           We can only change the account-no's if they are not   12450068
      *           allready registered.                                  12460068
      *                                                                 12470068
                 When RTFCE110-I-Type-I       (Ws-Idx) = 'U'            12480068
                  And RTFCE110-I-Type-D (      Ws-Idx) = 'CUSTM'        12490068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            12500068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            12510068
                  And RTFCE110-I-Operation-Type-D      = 'SETTLE-ILC'   12520068
                  And (   RTFCE110-I-Account-No-1-I (Ws-Idx) = 'U'      12530068
                       Or RTFCE110-I-Account-No-2-I (Ws-idx) = 'U' )    12540068
                   Set  Wb-Custm         To    True                     12550068
                   Perform E310-Read-Related-Party                      12560068
                                                                        12570068
                   If  R7919999-Return-OK                               12580068
                   And (   R115IRP0-Account   Not = Spaces              12590068
                        Or R115IRP0-Account-2 Not = Spaces )            12600068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  12610068
                       Move  'Belastningskonto'                         12620068
                                         To    R400CH01-Message-Data(1) 12630068
                       Move  'TF-SY-VAR-EXISTS'                         12640068
                                         To    R400CH01-Message-Code    12650068
                       Perform  Z700-Error-AE                           12660068
                   Else                                                 12670068
                       Set R7919999-Return-OK   To True                 12680068
                   End-If                                               12690068
                                                                        12700068
      *                                                                 12710068
      *           We can only change the reference of the Presenting    12720068
      *           Bank if this bank allready exist.                     12730068
      *                                                                 12740068
      *          When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            12750068
      *           And RTFCE110-I-Type-D (Ws-Idx)       = 'AVAIL'        12760068
      *           And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            12770068
      *           And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            12780068
      *           And (   RTFCE110-I-Operation-Type-D  = 'ACCEPT-ILC')  12790068
      *            Set  Wb-Avail         To    True                     12800068
      *            Perform E310-Read-Related-Party                      12810068
      *            If  R7919999-Return-OK                               12820068
      *            And (   RTFCE110-I-Customer-Id-I  (Ws-Idx) = 'U'     12830068
      *                 Or RTFCE110-I-Account-No-1-I (Ws-Idx) = 'U'     12840068
      *                 Or RTFCE110-I-Account-No-2-I (Ws-Idx) = 'U'  )  12850068
      *                Perform E330-Read-SYS-Code                       12860068
      *                Move  'VAR1'      To    R400CH01-Message-Key(1)  12870068
      *                Move  R115ISC0-Description                       12880068
      *                                  To    R400CH01-Message-Data(1) 12890068
      *                Move  'TF-SY-CHANGE-REF-ALLOWED'                 12900068
      *                                  To    R400CH01-Message-Code    12910068
      *                Perform  Z700-Error-AE                           12920068
      *            Else                                                 12930068
      *                Set R7919999-Return-OK   To True                 12940068
      *            End-If                                               12950068
                                                                        12960068
      *                                                                 12970068
      *           We can change the account no of the customer/applicant12980068
      *                                                                 12990068
                 When RTFCE110-I-Type-I     (Ws-Idx)   = 'U'            13000068
                  And RTFCE110-I-Type-D     (Ws-Idx)   = 'CUSTM'        13010068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            13020068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            13030068
                  And (   RTFCE110-I-Operation-Type-D  = 'ACCEPT-ILC'   13040068
                       Or RTFCE110-I-Operation-Type-D  = 'EXPIRE-ILC' ) 13050068
                                                                        13060068
                   If (   RTFCE110-I-Customer-Id-I   (Ws-Idx) = 'U'     13070068
                        Or RTFCE110-I-Reference-I    (Ws-Idx) = 'U' )   13080068
                       Set  Wb-Custm     To    True                     13090068
                       Perform E330-Read-SYS-Code                       13100068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  13110068
                       Move  R115ISC0-Description                       13120068
                                         To    R400CH01-Message-Data(1) 13130068
                       Move  'TF-SY-CHANGE-ACC-ALLOWED'                 13140068
                                         To    R400CH01-Message-Code    13150068
                       Perform  Z700-Error-AE                           13160068
                   End-If                                               13170068
                                                                        13180068
      *                                                                 13190068
      *           We can only register a new Debit Clearing Bank if     13200068
      *           this bank does not allready exist.                    13210068
      *                                                                 13220068
                 When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            13230068
                  And RTFCE110-I-Type-D (Ws-Idx)       = 'DECL'         13240068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            13250068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            13260068
                  And RTFCE110-I-Operation-Type-D      = 'DISPOSE'      13270068
                   Set  Wb-Decl          To    True                     13280068
                   Perform E310-Read-Related-Party                      13290068
                   If  R7919999-Return-OK                               13300068
                       Move  'F'         To    RTFCE110-I-Type-O        13310068
                                               (Ws-Idx)                 13320068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  13330068
                       Move  'Dekningsbank'                             13340068
                                         To    R400CH01-Message-Data(1) 13350068
                       Move  'TF-SY-VAR-EXISTS'                         13360068
                                         To    R400CH01-Message-Code    13370068
                       Perform  Z700-Error-AE                           13380068
                   Else                                                 13390068
                       Set R7919999-Return-OK   To True                 13400068
                   End-If                                               13410068
                                                                        13420068
      *    27.04.04 (ndl)                                               13430068
      *    Kunde-Id must be zero and customer-type = 'T' (tastpart)     13440068
      *    When custm-type = 'ISSTP'                                    13450068
      *                                                                 13460068
                 When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            13470068
                  And RTFCE110-I-Type-D (Ws-Idx)       = 'ISSTP'        13480068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            13490068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            13500068
                  And RTFCE110-I-Operation-Type-D      = 'DISPOSE'      13510068
                  And RTFCE110-I-Customer-Id-D   (Ws-Idx) > +0          13520068
      *           And RTFCE110-I-Custm-Type-D (Ws-Idx) Not = 'T'        13530068
                       Move  'F'         To    RTFCE110-I-Type-O        13540068
                                               (Ws-Idx)                 13550068
                       Move  'FELT1'     To    R400CH01-Message-Key(1)  13560068
                       Move  'Kundenr, må være tastepart'               13570068
                                         To    R400CH01-Message-Data(1) 13580068
                       Move  'GL-UGYLDIG-VERDI&'                        13590068
                                         To    R400CH01-Message-Code    13600068
                       Perform  Z700-Error-AE                           13610068
      *                                                                 13620068
      *           We can only change the reference of the beneficiant   13630068
      *                                                                 13640068
                 When RTFCE110-I-Type-I     (Ws-Idx)   = 'U'            13650068
                  And RTFCE110-I-Type-D     (Ws-Idx)   = 'BENEF'        13660068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            13670068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            13680068
                  And RTFCE110-I-Operation-Type-D      = 'DISPOSE'      13690068
                   If (   RTFCE110-I-Customer-Id-I   (Ws-Idx) = 'U'     13700068
                        Or RTFCE110-I-Account-No-1-I (Ws-Idx) = 'U'     13710068
                        Or RTFCE110-I-Account-No-2-I (Ws-Idx) = 'U' )   13720068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  13730068
                       Move  'benefisiantens'                           13740068
                                         To    R400CH01-Message-Data(1) 13750068
                       Move  'TF-SY-CHANGE-REF-ALLOWED'                 13760068
                                         To    R400CH01-Message-Code    13770068
                       Perform  Z700-Error-AE                           13780068
                   End-If                                               13790068
                                                                        13800068
      *                                                                 13810068
      *           We can only register a new confirming bank if         13820068
      *           this bank does not allready exist.                    13830068
      *                                                                 13840068
                 When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            13850068
                  And RTFCE110-I-Type-D (Ws-Idx)       = 'CONF'         13860068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            13870068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            13880068
                  And RTFCE110-I-Operation-Type-D      = 'ACCEPT-ELC'   13890068
                   Set  Wb-Reimb         To    True                     13900068
                   Perform E310-Read-Related-Party                      13910068
                   If  R7919999-Return-OK                               13920068
                       Move  'F'         To    RTFCE110-I-Type-O        13930068
                                               (Ws-Idx)                 13940068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  13950068
                       Move  'Bekreftende bank'                         13960068
                                         To    R400CH01-Message-Data(1) 13970068
                       Move  'TF-SY-VAR-EXISTS'                         13980068
                                         To    R400CH01-Message-Code    13990068
                       Perform  Z700-Error-AE                           14000068
                   Else                                                 14010068
                       Set R7919999-Return-OK   To True                 14020068
                   End-If                                               14030068
                                                                        14040068
      *                                                                 14050068
      *           We can only register a new Presenting Bank if         14060068
      *           this bank does not allready exist.                    14070068
      *                                                                 14080068
                 When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            14090068
                  And RTFCE110-I-Type-D (Ws-Idx)       = 'AVAIL'        14100068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            14110068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            14120068
                  And RTFCE110-I-Operation-Type-D      = 'ACCEPT-ELC'   14130068
                   Set  Wb-Reimb         To    True                     14140068
                   Perform E310-Read-Related-Party                      14150068
                   If  R7919999-Return-OK                               14160068
                       Move  'F'         To    RTFCE110-I-Type-O        14170068
                                               (Ws-Idx)                 14180068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  14190068
                       Move  'Presenterende bank'                       14200068
                                         To    R400CH01-Message-Data(1) 14210068
                       Move  'TF-SY-VAR-EXISTS'                         14220068
                                         To    R400CH01-Message-Code    14230068
                       Perform  Z700-Error-AE                           14240068
                   Else                                                 14250068
                       Set R7919999-Return-OK   To True                 14260068
                   End-If                                               14270068
                                                                        14280068
      *                                                                 14290068
      *           We can only register a new issuing bank if            14300068
      *           this bank does not allready exist.                    14310068
      *                                                                 14320068
                 When RTFCE110-I-Type-I (Ws-Idx)       = 'U'            14330068
                  And RTFCE110-I-Type-D (Ws-Idx)       = 'ISSUI'        14340068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            14350068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            14360068
                  And RTFCE110-I-Operation-Type-D      = 'ACCEPT-ELC'   14370068
                   Set  Wb-Reimb         To    True                     14380068
                   Perform E310-Read-Related-Party                      14390068
                   If  R7919999-Return-OK                               14400068
                       Move  'F'         To    RTFCE110-I-Type-O        14410068
                                               (Ws-Idx)                 14420068
                       Move  'VAR1'      To    R400CH01-Message-Key(1)  14430068
                       Move  'Bekreftende bank'                         14440068
                                         To    R400CH01-Message-Data(1) 14450068
                       Move  'TF-SY-VAR-EXISTS'                         14460068
                                         To    R400CH01-Message-Code    14470068
                       Perform  Z700-Error-AE                           14480068
                   Else                                                 14490068
                       Set R7919999-Return-OK   To True                 14500068
                   End-If                                               14510068
                                                                        14520068
               End-Evaluate                                             14530068
      *                                                                 14540068
      *           We can not allow the owner of the                     14550068
      *           contract to be a tast-part or bic-part.               14560068
      *                                                                 14570068
                 If   RTFCE110-I-Type-I (Ws-Idx)       = 'U'            14580068
                  And RTFCE110-I-Type-D (Ws-Idx)      = 'DRWER'         14590068
      *           Or   RTFCE110-I-Type-D (Ws-Idx)      = 'REMIT')       14600068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            14610068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            14620068
                  And RTFCE110-I-Custm-Type-I (Ws-Idx) = 'U'            14630068
                  And  RTFCE110-I-Custm-Type-D (Ws-Idx) = 'T'           14640068
      *           Or   RTFCE110-I-Custm-Type-D (Ws-Idx) = 'B')          14650068
                                                                        14660068
                  If  (RTFCE110-I-Contract-Type-D      = 'EDP'          14670068
                  Or   RTFCE110-I-Contract-Type-D      = 'EDA'          14680068
                  Or   RTFCE110-I-Contract-Type-D      = 'ECP'          14690068
                  Or   RTFCE110-I-Contract-Type-D      = 'ECA')         14700068
                       Move  'F'         To    RTFCE110-I-Custm-Type-O  14710068
                                               (Ws-Idx)                 14720068
                       Move  'TF-SY-NO-TASTPART'                        14730068
                                         To    R400CH01-Message-Code    14740068
                       Perform  Z700-Error-AE                           14750068
                  End-If                                                14760068
                 End-If                                                 14770068
                                                                        14780068
                 If   RTFCE110-I-Type-I (Ws-Idx)       = 'U'            14790068
      *           And (RTFCE110-I-Type-D (Ws-Idx)      = 'REMIT'        14800068
                  And  RTFCE110-I-Type-D (Ws-Idx)      = 'DRWEE'        14810068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            14820068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            14830068
                  And RTFCE110-I-Custm-Type-I (Ws-Idx) = 'U'            14840068
                  And  RTFCE110-I-Custm-Type-D (Ws-Idx) = 'T'           14850068
      **          Or   RTFCE110-I-Custm-Type-D (Ws-Idx) = 'B')          14860068
                                                                        14870068
                  If  (RTFCE110-I-Contract-Type-D      = 'IDP'          14880068
                  Or   RTFCE110-I-Contract-Type-D      = 'IDA'          14890068
                  Or   RTFCE110-I-Contract-Type-D      = 'ICP'          14900068
                  Or   RTFCE110-I-Contract-Type-D      = 'ICA')         14910068
                       Move  'F'         To    RTFCE110-I-Custm-Type-O  14920068
                                               (Ws-Idx)                 14930068
                       Move  'TF-SY-NO-TASTPART'                        14940068
                                         To    R400CH01-Message-Code    14950068
                       Perform  Z700-Error-AE                           14960068
                  End-If                                                14970068
                 End-If                                                 14980068
                                                                        14990068
                 If   RTFCE110-I-Type-I (Ws-Idx)       = 'U'            15000068
                  And (RTFCE110-I-Type-D (Ws-Idx)      = 'CUSTM'        15010068
                   or  RTFCE110-I-Type-D (Ws-Idx)      = 'ADVIS')       15020068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            15030068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            15040068
                  And RTFCE110-I-Custm-Type-I (Ws-Idx) = 'U'            15050068
                  And  RTFCE110-I-Custm-Type-D (Ws-Idx) = 'T'           15060068
      *           Or   RTFCE110-I-Custm-Type-D (Ws-Idx) = 'B')          15070068
                                                                        15080068
                  If  (RTFCE110-I-Contract-Type-D      = 'ILC'          15090068
                  Or   RTFCE110-I-Contract-Type-D      = 'ILU')         15100068
                       Move  'F'         To    RTFCE110-I-Custm-Type-O  15110068
                                               (Ws-Idx)                 15120068
                       Move  'TF-SY-NO-TASTPART'                        15130068
                                         To    R400CH01-Message-Code    15140068
                       Perform  Z700-Error-AE                           15150068
                  End-If                                                15160068
                 End-If                                                 15170068
                                                                        15180068
                 If   RTFCE110-I-Type-I (Ws-Idx)       = 'U'            15190068
                  And RTFCE110-I-Type-D (Ws-Idx)      = 'ISSUI'         15200068
                  And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'            15210068
                  And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'            15220068
                  And RTFCE110-I-Custm-Type-I (Ws-Idx) = 'U'            15230068
                  And  RTFCE110-I-Custm-Type-D (Ws-Idx) = 'T'           15240068
      *           Or   RTFCE110-I-Custm-Type-D (Ws-Idx) = 'B')          15250068
                                                                        15260068
                  If  (RTFCE110-I-Contract-Type-D      = 'ELC'          15270068
                  Or   RTFCE110-I-Contract-Type-D      = 'ECC'          15280078
                  Or   RTFCE110-I-Contract-Type-D      = 'ELG')         15281077
                       Move  'F'         To    RTFCE110-I-Custm-Type-O  15290068
                                               (Ws-Idx)                 15300068
                       Move  'TF-SY-NO-TASTPART'                        15310068
                                         To    R400CH01-Message-Code    15320068
                       Perform  Z700-Error-AE                           15330068
                  End-If                                                15340068
                 End-If                                                 15350068
                                                                        15360068
                                                                        15370068
               Add  1                    To    Ws-Idx                   15380068
           End-Perform                                                  15390068
      *                                                                 15400068
           .                                                            15410068
      *                                                                 15420068
       E300-Check-Related-Party-Ex.                                     15430068
           Exit.                                                        15440068

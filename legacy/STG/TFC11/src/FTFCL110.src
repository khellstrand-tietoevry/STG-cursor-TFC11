      *################################################################*02740099
      * Control your database updates/queries from here. Use Perform   *02750099
      * statements to the different database parts that will be        *02760099
      * accessed in such a way that one section only controls update of*02770099
      * one database element.                                          *02780099
      *----------------------------------------------------------------*02790099
       G000-Update                       Section.                       02800099
      *                                                                 02810099
           Set  Wb-In-Actual             To    True                     02820099
           Perform H200-Read-Main-Contract                              02830099
           If  R115IMC0-In-Progress Not = 'Y'                           02840099
               Perform G600-Create-Shadow                               02850099
           End-If                                                       02860099
      *                                                                 02870099
           If  RTFCE110-I-Part-Amount-No-I = 'U'                        02880099
               Perform H300-Read-Contract-Amount                        02890099
           End-If                                                       02900099
      *                                                                 02910099
           Move  +1                      To    Ws-Idx                   02920099
      *                                                                 02930099
           Perform Until Ws-Idx > Ws-Max-Occ-Item-Tab                   02940099
                                                                        02950099
               Evaluate True                                            02960099
                 When RTFCE110-I-Selected-D (Ws-Idx) = 'N'              02970099
      * 1.       Deleting Related_Party and Tast_Part.                  02980099
                                                                        02990099
                   Move  RTFCE110-I-Type-D (Ws-Idx)                     03000099
                                         To    Ws-Role-Type             03010099
                   If  RTFCE110-I-Part-Amount-No-I Not = 'U'            03020099
                       Set  Wb-Main      To    True                     03030099
                   Else                                                 03040099
                       Set  Wb-Part      To    True                     03050099
                   End-If                                               03060099
                                                                        03070099
                   Perform H100-Read-Related-Party                      03080099
                                                                        03090099
                   If  R7919999-Return-OK                               03100099
                       Perform G300-Delete-Related-Party                03110099
                   End-If                                               03120099
      *                                                                 03130099
                 When RTFCE110-I-Selected-D (Ws-Idx) = 'Y'              03140099
                  And (    RTFCE110-I-Operation-Type-D = 'ACCEPT-COLL'  03150099
                        Or RTFCE110-I-Operation-Type-D = 'RETURN'       03160099
                        Or RTFCE110-I-Operation-Type-D = 'EXPIRE-ILC'   03170099
                        Or RTFCE110-I-Operation-Type-D = 'EXPIRE-GAR' ) 03171099
                                                                        03180099
      * 2.       Update Related_Party on part                           03190099
      *          These screens can only update reference and accounts,  03200099
                   Move  RTFCE110-I-Type-D (Ws-Idx)                     03210099
                                         To    Ws-Role-Type             03220099
                   Set  Wb-Part          To    True                     03230099
                   Perform H100-Read-Related-Party                      03240099
                   If  R7919999-Return-OK                               03250099
      *            Party already exists on Related_Party - part.        03260099
      *            We update...                                         03270099
                       Perform G100-Update-Related-Party                03280099
                   Else                                                 03290099
      *            Party does not exist on Related_Party - part.        03300099
      *            We look for it on Related-Party - main.              03310099
                       Set  Wb-Main      To    True                     03320099
                       Perform H100-Read-Related-Party                  03330099
                       If  R7919999-Return-OK                           03340099
      *                Party exists on Related_Party - main. We copy it 03350099
      *                into Related_Party - part.                       03360099
                           Perform G250-Insert-Related-Party            03370099
      *                    If R115IRP0-Customer-Id > 0                  03380099
      *                    We also check Tast_Part - main.              03390099
                             Perform H500-Read-Tast-Part                03400099
                             If  R7919999-Return-OK                     03410099
      *                      Part exists on Tast_Part - main. We copy it03420099
      *                      into Tast_Part - part.                     03430099
                                 Perform G850-Insert-Tast-Part          03440099
                             End-If                                     03450099
      *                    End-If                                       03460099
                       Else                                             03470099
                           Perform H400-Read-SYS-Code                   03480099
                           Move  'VAR1'  To    R400CH01-Message-Key(1)  03490099
                           Move  R115ISC0-Description                   03500099
                                         To    R400CH01-Message-Data(1) 03510099
                           Move  'TF-SY-NO-PART'                        03520099
                                         To    R400CH01-Message-Code    03530099
                           Perform Z700-Error-AE                        03540099
                       End-If                                           03550099
                   End-If                                               03560099
                                                                        03570099
                 When RTFCE110-I-Selected-D (Ws-Idx) = 'Y'              03580099
                  And (    RTFCE110-I-Operation-Type-D = 'SETTLE-ILC'   03590099
                        Or RTFCE110-I-Operation-Type-D = 'ACCEPT-ILC'   03600099
                        Or RTFCE110-I-Operation-Type-D = 'DISPOSE'      03610099
                        Or RTFCE110-I-Operation-Type-D = 'ACCEPT-ELC'   03620099
                        Or RTFCE110-I-Operation-Type-D = 'SETTLE-ELC'   03630099
                        Or RTFCE110-I-Operation-Type-D = 'SETTLE-COLL') 03640099
                                                                        03650099
      * 3.       New Related_Party on part or update                    03660099
                   Move  RTFCE110-I-Type-D (Ws-Idx)                     03670099
                                         To    Ws-Role-Type             03680099
                   Set  Wb-Part          To    True                     03690099
                   Perform H100-Read-Related-Party                      03700099
                                                                        03710099
                   Evaluate True                                        03720099
                     When R7919999-Return-OK                            03730099
      *                Party already exists on Related_Party - part.    03740099
      *                We update...                                     03750099
                       If  R115IRP0-Customer-Id > 0                     03760099
      *                Sjekker innkomne kundetype:                      03770099
                           Evaluate RTFCE110-I-Custm-Type-D (Ws-Idx)    03780099
                           When 'T'                                     03790099
      *                       - We change from real part to tastpart    03800099
                              Perform G300-Delete-Related-Party         03810099
                              Move +0      To R115IRP0-Customer-Id      03820099
                              Perform G200-Insert-Related-Party         03830099
                              Perform G800-Insert-Tast-Part             03840099
      *                    When 'B'                                     03850099
      *                       - We change from real part to bic-part    03860099
      *                       Perform G300-Delete-Related-Party         03870099
      *                       Move +0      To R115IRP0-Customer-Id      03880099
      *                       Perform G200-Insert-Related-Party         03890099
                           When Other                                   03900099
      *                       - We change real part                     03910099
                              Perform G100-Update-Related-Party         03920099
                           End-Evaluate                                 03930099
                       Else                                             03940099
      *                    R115IRP0-Customer-Id = 0                     03950099
      *lg start            Evaluate RTFCE110-I-Custm-Type-D (Ws-Idx)    03960099
      *lg slutt            When 'T'                                     03970099
      *                       Endrer fra Bic-part til tastpart          03980099
      *lg start               If R115IRP0-Bic-Bank > Spaces             03990099
      *                          Perform G100-Update-Related-Party      04000099
      *                          Perform G800-Insert-Tast-Part          04010099
      *                       Else                                      04020099
      *                       Oppdaterer tastpart                       04030099
      *                          Perform G100-Update-Related-Party      04040099
      *                          Perform H500-Read-Tast-Part            04050099
      *                          If R7919999-Return-OK                  04060099
      *                            Perform G700-Update-Tast-Part        04070099
      *                          Else                                   04080099
      *                            Set  R7919999-Return-OK To True      04090099
      *                          End-If                                 04100099
      *lg slutt               End-If                                    04110099
      *                    When 'B'                                     04120099
      *                       If R115IRP0-Bic-Bank = Spaces             04130099
      *                       Endrer fra tastpart til Bic-part          04140099
      *                          Perform  H500-Read-Tast-Part           04150099
      *                          If  R7919999-Return-OK                 04160099
      *                            Perform  G900-Delete-Tast-Part       04170099
      *                          Else                                   04180099
      *                            Set  R7919999-Return-OK To True      04190099
      *                          End-If                                 04200099
      *                       End-If                                    04210099
      *                       Perform G100-Update-Related-Party         04220099
      *                    When Other                                   04230099
      *                       - We change from tastpart to real part    04240099
                              If RTFCE110-I-Customer-Id-D (Ws-Idx) > 0  04250099
                                 Perform G300-Delete-Related-Party      04260099
                                 Move RTFCE110-I-Customer-Id-D (Ws-Idx) 04270099
                                                 To R115IRP0-Customer-Id04280099
                                 Perform G200-Insert-Related-Party      04290099
                              Else                                      04300099
      *                       - We change part                          04310099
                                 Perform G100-Update-Related-Party      04320099
                              End-If                                    04330099
      *                    End-Evaluate                                 04340099
                       End-If                                           04350099
                                                                        04360099
                     When (RTFCE110-I-Customer-Id-I (Ws-Idx) = 'U'      04370099
                      Or  (RTFCE110-I-Custm-Type-I  (Ws-Idx) = 'U'      04380099
                      and  RTFCE110-I-Custm-Type-D  (Ws-Idx) = 'T' ))   04390099
      *               or   RTFCE110-I-Custm-Type-D  (Ws-Idx) = 'B'      04400099
                      And RTFCE110-I-Operation-Type-D = 'SETTLE-ILC'    04410099
      * ndl 08.11.2000, fjernet test på rolletype                       04420099
      *               And RTFCE110-I-Type-D (Ws-Idx)  = 'AVAIL'         04430099
      *                We insert the party on Related_Party - part.     04440099
                       Perform G200-Insert-Related-Party                04450099
      *                and on tast part                                 04460099
                       If  RTFCE110-I-Custm-Type-I  (Ws-Idx) = 'U'      04470099
                       and RTFCE110-I-Custm-Type-D  (Ws-Idx) = 'T'      04480099
                           Perform G800-Insert-Tast-Part                04490099
                       End-If                                           04500099
                                                                        04501099
      * ndl 18.04.2007, feilretting AVAIL ved accept-ilc                04501199
                     When (RTFCE110-I-Customer-Id-I (Ws-Idx) = 'U'      04502099
                      Or  (RTFCE110-I-Custm-Type-I  (Ws-Idx) = 'U'      04503099
                      and  RTFCE110-I-Custm-Type-D  (Ws-Idx) = 'T' ))   04504099
      *               or   RTFCE110-I-Custm-Type-D  (Ws-Idx) = 'B'      04505099
                      And RTFCE110-I-Operation-Type-D = 'ACCEPT-ILC'    04506099

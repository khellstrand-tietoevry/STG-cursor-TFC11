               If   RTFCE110-I-Type-I (Ws-Idx)       = 'U'              07510099
               And RTFCE110-I-Type-D (Ws-Idx)       = 'ISSUI'           07520099
               And RTFCE110-I-Selected-I (Ws-Idx)   = 'U'               07530099
               And RTFCE110-I-Selected-D (Ws-Idx)   = 'Y'               07540099
               And RTFCE110-I-Operation-Type-D      = 'ADVICE'          07550099
               And RTFCE110-I-Reference-I (Ws-Idx)  = 'U'               07560099

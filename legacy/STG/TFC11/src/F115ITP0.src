                                         To    R7918030-In-MessageCode  10930000
               Perform Z000-Error-Message                               10940000
               Set   R7919999-Return-Error                              10950000
                                         To    True                     10960000
                                                                        10970000
           End-Evaluate                                                 10980000
      *                                                                 10990000
           Evaluate True                                                11000000
             When R115ITP0-Contract-Type Not = Space                    11010000
               Continue                                                 11020000
                                                                        11030000
             When R115ITP0-In-Contract-Type                             11040000
                                         Not = Space                    11050000
               Move R115ITP0-In-Contract-Type                           11060000
                                         To    R115ITP0-Contract-Type   11070000
                                                                        11080000
             When other                                                 11090000
               Initialize                      R7918030-ErrorMessage    11100000
               Move  'TF-CONTRACT-MISSING'                              11110000
                                         To    R7918030-In-MessageCode  11120000
               Perform Z000-Error-Message                               11130000
               Set   R7919999-Return-Error                              11140000
                                         To    True                     11150000
                                                                        11160000
           End-Evaluate                                                 11170000
      *                                                                 11180000
           Evaluate True                                                11190000
             When R115ITP0-Contract-No   Not = +0                       11200000
               Continue                                                 11210000
                                                                        11220000
             When R115ITP0-In-Contract-No                               11230000
                                         Not = +0                       11240000
               Move R115ITP0-In-Contract-No                             11250000
                                         To    R115ITP0-Contract-No     11260000
                                                                        11270000
             When other                                                 11280000
               Initialize                      R7918030-ErrorMessage    11290000
               Move  'TF-CONTRACT-MISSING'                              11300000
                                         To    R7918030-In-MessageCode  11310000
               Perform Z000-Error-Message                               11320000
               Set   R7919999-Return-Error                              11330000
                                         To    True                     11340000
                                                                        11350000
           End-Evaluate                                                 11360000
      *                                                                 11370000
           Evaluate True                                                11380001
             When R115ITP0-Role-Type     Not = Space                    11390001
               Continue                                                 11400001
                                                                        11410001
             When R115ITP0-In-Role-Type Not = Space                     11420001
               Move R115ITP0-In-Role-Type                               11430001
                                         To    R115ITP0-Role-Type       11440001
                                                                        11450001
             When other                                                 11460001
               Initialize                      R7918030-ErrorMessage    11470001
               Move  'TF-ROLE-MISSING'   To    R7918030-In-MessageCode  11480004

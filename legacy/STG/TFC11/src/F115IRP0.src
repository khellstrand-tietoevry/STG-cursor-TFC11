           Move  WE-Role-Type            To    W-DB-Role-Type           05320019
           Move  WE-Customer-ID          To    W-DB-Customer-ID         05330043
      *                                                                 05340000
           If  WE-Fin-Inst-No            Not = Space                    05350000
           and W-DB-Fin-Inst-ID          =     +0                       05360000
               Move  WE-Fin-Inst-No      To    W-Fin-Inst-No            05370000
               Perform N100-Fetch-Fin-Inst-ID                           05380000
               Move  W-Fin-Inst-ID       To    W-DB-Fin-Inst-ID         05390000
           End-If                                                       05400000
      *                                                                 05410000
           If  WE-Customer-No            Not = +0                       05420045
           and W-DB-Customer-ID          =     +0                       05430045
               Move  WE-Customer-No      To    W-Customer-No            05440045
               Perform N300-Fetch-Customer-ID                           05450045
               Move  W-Customer-ID       To    W-DB-Customer-ID         05460045
           End-If                                                       05470045
      *                                                                 05480045
           .                                                            05490000
      *################################################################.05500000
       D300-Select-Cursor                Section.                       05510000
      *                                                                 05520000
      * We choose which cursor to use, depending on the qualification.  05530000
      *                                                                 05540000
           Move  Space                   To    SW-Cursor-Code           05550000
      *                                                                 05560000
           If  W-DB-Fin-Inst-ID          Not = +0                       05570000
               Set  Sw-Use-Fin-Inst      To    True                     05580000
           End-If                                                       05590000
      *                                                                 05600000
           If  W-DB-Contract-Type        Not = Space                    05610028
      *    and W-DB-Contract-Type (1:1)  Not = '%'                      05620049
               Set   SW-Use-Contract-Type                               05630000
                                         To    True                     05640000
           End-If                                                       05650027
      *                                                                 05660000
           If  W-DB-Contract-No          Not = +0                       05670050
               Set   SW-Use-Contract-No  To    True                     05680000
           End-If                                                       05690050
      *                                                                 05700000
           If  Not R115IRP0-In-Rel-Any                                  05711056
               Set  Sw-Use-Part-Amount   To    True                     05720019
           End-If                                                       05730019
      *                                                                 05740019
           If  W-DB-Role-Type            Not = Space                    05750028
           and W-DB-Role-Type (1:1)      Not = '%'                      05760028
               Set  Sw-Use-Role          To    True                     05770000
           End-If                                                       05780000
      *                                                                 05790000
           If  W-DB-Customer-ID          Not = +0                       05800043
               Set  Sw-Use-Customer-ID   To    True                     05810043
           End-If                                                       05820043
      *                                                                 05830043
           Evaluate True                                                05840000
             When SW-Use-Fi-Asc                                         05850000
             or   SW-Use-Fi-CT-Asc                                      05860000
             or   SW-Use-Fi-CT-Cu-Asc                                   05860159
             or   SW-Use-Fi-CU-Asc                                      05861053
             or   SW-Use-Fi-Ro-Asc                                      05870002
             or   SW-Use-Fi-CTN-Asc                                     05880046
             or   SW-Use-Fi-CTN-PA-Asc                                  05890046
             or   SW-Use-Fi-CT-Ro-Asc                                   05900002
             or   SW-Use-Fi-CT-Ro-Cu-Asc                                05910043
             or   SW-Use-Fi-CTN-Ro-Asc                                  05920046
             or   SW-Use-Fi-CTN-Ro-Cu-Asc                               05930046
             or   SW-Use-Fi-CTN-PA-Ro-Asc                               05940046
               Continue                                                 05950000
      *                                                                 05960000
             When other                                                 05970000
               Initialize                      R7918030-ErrorMessage    05980000
               Move  'GL-CURSOR-UV'      To    R7918030-In-MessageCode  05990000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)06000000
               Move  SW-Cursor-Code      To R7918030-In-Variable-Data(1)06010000

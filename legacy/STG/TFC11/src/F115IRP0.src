      *################################################################.09650000
       H100-Check-Qualification          Section.                       09660000
      *                                                                 09670000
           Evaluate True                                                09680000
             When R115IRP0-Fin-Inst-ID   Not = +0                       09690000
               Continue                                                 09700000
                                                                        09710000
             When R115IRP0-Fin-Inst-No   Not = Space                    09720000
               Move  R115IRP0-Fin-Inst-No                               09730000
                                         To    W-Fin-Inst-No            09740000
               Perform N100-Fetch-Fin-Inst-ID                           09750000
               Move  W-Fin-Inst-ID       To    R115IRP0-Fin-Inst-ID     09760000
                                                                        09770000
             When R115IRP0-In-Fin-Inst-Id Not = +0                      09780000
               Move R115IRP0-In-Fin-Inst-ID                             09790000
                                         To    R115IRP0-Fin-Inst-ID     09800000
                                                                        09810000
             When R115IRP0-In-Fin-Inst-No                               09820000
                                         Not = Space                    09830000
               Move  R115IRP0-In-Fin-Inst-No                            09840000
                                         To    W-Fin-Inst-No            09850000
               Perform N100-Fetch-Fin-Inst-ID                           09860000
               Move  W-Fin-Inst-ID       To    R115IRP0-Fin-Inst-ID     09870000
                                                                        09880000
             When other                                                 09890000
               Initialize                      R7918030-ErrorMessage    09900000
               Move  'TF-FIN-INST-MISSING'                              09910000
                                         To    R7918030-In-MessageCode  09920000
               Perform Z000-Error-Message                               09930000
               Set   R7919999-Return-Error                              09940000
                                         To    True                     09950000
                                                                        09960000
           End-Evaluate                                                 09970000
      *                                                                 09980000
           Evaluate True                                                09990000
             When R115IRP0-Contract-Type Not = Space                    10000000
               Continue                                                 10010000
                                                                        10020000
             When R115IRP0-In-Contract-Type                             10030000
                                         Not = Space                    10040000
               Move R115IRP0-In-Contract-Type                           10050000
                                         To    R115IRP0-Contract-Type   10060000
                                                                        10070000
             When other                                                 10080000
               Initialize                      R7918030-ErrorMessage    10090000
               Move  'TF-CONTRACT-MISSING'                              10100000
                                         To    R7918030-In-MessageCode  10110000
               Perform Z000-Error-Message                               10120000
               Set   R7919999-Return-Error                              10130000
                                         To    True                     10140000
                                                                        10150000
           End-Evaluate                                                 10160000
      *                                                                 10170000
           Evaluate True                                                10180000
             When R115IRP0-Contract-No   Not = +0                       10190000
               Continue                                                 10200000
                                                                        10210000
             When R115IRP0-In-Contract-No                               10220000
                                         Not = +0                       10230000
               Move R115IRP0-In-Contract-No                             10240000
                                         To    R115IRP0-Contract-No     10250000
                                                                        10260000
             When other                                                 10270000
               Initialize                      R7918030-ErrorMessage    10280000
               Move  'TF-CONTRACT-MISSING'                              10290000
                                         To    R7918030-In-MessageCode  10300000
               Perform Z000-Error-Message                               10310000
               Set   R7919999-Return-Error                              10320000
                                         To    True                     10330000
                                                                        10340000
           End-Evaluate                                                 10350000
      *                                                                 10360000
           Evaluate True                                                10370019
             When R115IRP0-In-Rel-MC                                    10380019
               Continue                                                 10390019
                                                                        10400019
             When R115IRP0-CA-Currency   Not = Space                    10410019
               Continue                                                 10420019
                                                                        10430019
             When R115IRP0-In-CA-Currency                               10440019
                                         Not = Space                    10450019
               Move R115IRP0-In-CA-Currency                             10460019
                                         To    R115IRP0-CA-Currency     10470019
                                                                        10480019
             When other                                                 10490019
               Initialize                      R7918030-ErrorMessage    10500019
               Move  'TF-PART-AMOUNT-MISSING'                           10510019
                                         To    R7918030-In-MessageCode  10520019
               Perform Z000-Error-Message                               10530019
               Set   R7919999-Return-Error                              10540019
                                         To    True                     10550019
                                                                        10560019
           End-Evaluate                                                 10570019
      *                                                                 10580019
           Evaluate True                                                10590019
             When R115IRP0-In-Rel-MC                                    10600019
               Continue                                                 10610019
                                                                        10620019
             When R115IRP0-PA-Seq-No     Not = +0                       10630019
               Continue                                                 10640019
                                                                        10650019
             When R115IRP0-In-PA-Seq-No  Not = +0                       10660019
               Move R115IRP0-In-PA-Seq-No                               10670019
                                         To    R115IRP0-PA-Seq-No       10680019
                                                                        10690019
             When other                                                 10700019
               Initialize                      R7918030-ErrorMessage    10710019
               Move  'TF-PART-AMOUNT-MISSING'                           10720019
                                         To    R7918030-In-MessageCode  10730019
               Perform Z000-Error-Message                               10740019
               Set   R7919999-Return-Error                              10750019
                                         To    True                     10760019
                                                                        10770019
           End-Evaluate                                                 10780019
      *                                                                 10790019
           Evaluate True                                                10800002
             When R115IRP0-Role-Type     Not = Space                    10810002
               Continue                                                 10820019
                                                                        10830002
             When R115IRP0-In-Role-Type  Not = Space                    10840002
               Move  R115IRP0-In-Role-Type                              10850002
                                         To    R115IRP0-Role-Type       10860019
                                                                        10870002
             When other                                                 10880002
               Initialize                      R7918030-ErrorMessage    10890002
               Move  'TF-ROLE-MISSING'   To    R7918030-In-MessageCode  10900002
               Perform Z000-Error-Message                               10910002
               Set   R7919999-Return-Error                              10920002
                                         To    True                     10930002
                                                                        10940002
           End-Evaluate                                                 10950002
      *                                                                 10960002
           .                                                            10970000
      *################################################################.10980000
       H200-Update-Row                   Section.                       10990000
      *                                                                 11000000
           Initialize                          R115IRPS-SQL-Submodules  11010000
           Set   R115IRPS-Version        To    True                     11020000
           Set   R115IRPS-In-Update      To    True                     11030000
           Move  R115IRP0-In-Table-Version                              11040036
                                         To    R115IRPS-In-Table-Version11050036
      *                                                                 11060000
           Call  'F115IRPU'              Using R115IRPS-SQL-Submodules  11070000
                                               DCLTF-Related-Party      11080000
                                               R7919999-Error-Area      11090000
